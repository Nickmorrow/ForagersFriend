@page "/Account/Email"
@attribute [Authorize]

<PageTitle>Account email</PageTitle>

<h3>Change email address</h3>

<p>Your address will change only after you confirm the link sent to the new address. Open that link while signed in to this account.</p>

<form method="post" action="/account/email-change">
    <AntiforgeryToken />
    <label for="NewEmail">New email address</label>
    <input id="NewEmail" name="NewEmail" type="email" maxlength="256" required />
    <button type="submit">Send confirmation</button>
</form>

@if (StatusMessage is not null)
{
    <p role="status">@StatusMessage</p>
}

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private string? StatusMessage => Status switch
    {
        "confirmation-sent" => "If the address can be used, a confirmation link will be sent.",
        "updated" => "Your email address has been updated.",
        "same-email" => "Enter a different email address.",
        "unavailable" => "Unable to process that address. Check it and try again later.",
        "invalid" => "Enter a valid email address no longer than 256 characters.",
        "confirmation-invalid" => "This email-change link is invalid, expired, or belongs to another account.",
        _ => null
    };
}
