@page "/Login"
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<h3>Login</h3>

<div>
    <div>
        <form method="post" action="/account/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label for="UserNameInput">Username</label>
            <input id="UserNameInput" name="Username" maxlength="256" required />

            <label for="PasswordInput">Password</label>
            <input id="PasswordInput" name="Password" type="password" maxlength="256" required />

            <button type="submit" class="btn-primary">Login</button>
        </form>
    </div>
    @if (StatusMessage is not null)
    {
        <p style="color: red;">@StatusMessage</p>
    }

    <div>
        <NavLink href="/Registration">Register</NavLink>
        <NavLink href="/RecoverLoginInfo">Forgot Username or Password?</NavLink>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private string? StatusMessage => Status switch
    {
        "locked" => "Sign-in failed. Please try again later.",
        "confirmed" => "Your email is confirmed. You can now sign in.",
        "confirmation-invalid" => "This confirmation link is invalid or expired.",
        "invalid" => "Username or password is incorrect, or the email is not confirmed.",
        _ => null
    };

}
