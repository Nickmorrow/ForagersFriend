@page "/Registration"
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Registration</PageTitle>

<h3>Registration</h3>

<div>
    <form @ref="_registrationForm" method="post" action="/account/register">
        <AntiforgeryToken />

        <label for="NameInput">Name</label>
        <input id="NameInput" name="Name" maxlength="100" required />

        <label for="EmailInput">Email</label>
        <input id="EmailInput" name="Email" type="email" maxlength="256" required />

        <label for="CountryInput">Country</label>
        <input id="CountryInput" name="Country" maxlength="100" />

        <label for="StateInput">State or Province</label>
        <input id="StateInput" name="StateOrProvince" maxlength="100" />

        <label for="UserNameInput">Username</label>
        <input id="UserNameInput" name="Username" maxlength="256" required />

        <label for="PasswordInput">Password</label>
        <input id="PasswordInput" name="Password" type="password" minlength="8" maxlength="256" required />

        <label for="ConfirmPasswordInput">Confirm Password</label>
        <input id="ConfirmPasswordInput" name="ConfirmPassword" type="password" maxlength="256" required />

        <button type="submit" class="btn-primary" disabled="@IsRegistrationLimited">Register</button>
    </form>

    <h4>Resend verification email</h4>
    <form method="post" action="/account/recover">
        <AntiforgeryToken />
        <label for="ResendEmailInput">Email</label>
        <input id="ResendEmailInput" name="Email" type="email" maxlength="256" required />
        <input type="hidden" name="RequestType" value="confirmation" />
        <input type="hidden" name="returnUrl" value="/Registration?status=verification-requested" />
        <button type="submit">Resend verification email</button>
    </form>

    @if (IsRegistrationLimited)
    {
        <p id="registration-rate-limit-message" role="status" aria-live="polite">@RateLimitMessage</p>
    }
    else
    {
        <p id="registration-rate-limit-message" role="status" aria-live="polite" hidden></p>
    }

    <NavLink href="/Login">Back</NavLink>

    @if (StatusMessage is not null)
    {
        <p style="color: red;">@StatusMessage</p>
    }
    @if (ValidationMessages.Count > 0)
    {
        <ul style="color: red;">
            @foreach (var message in ValidationMessages)
            {
                <li>@message</li>
            }
        </ul>
    }
</div>

@code {
    private ElementReference _registrationForm;
    private IJSObjectReference? _registrationFormModule;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "errors")]
    public string? Errors { get; set; }

    [SupplyParameterFromQuery(Name = "rateLimitUntil")]
    public long? RateLimitUntil { get; set; }

    private bool IsRegistrationLimited =>
        RateLimitUntil > DateTimeOffset.UtcNow.ToUnixTimeSeconds();

    private string? RateLimitMessage => IsRegistrationLimited
        ? $"Too many registration attempts. Try again in {Math.Max(1L, RateLimitUntil!.Value - DateTimeOffset.UtcNow.ToUnixTimeSeconds())} seconds."
        : null;

    private string? StatusMessage => Status switch
    {
        "development-created" => "Development mode: the account was created without email confirmation.",
        "confirmation-sent" => "If your account details are valid, a confirmation email has been sent.",
        "confirmation-unavailable" => "Your account was created, but the confirmation email could not be sent. Try resending it below.",
        "verification-requested" => "If an eligible account matches that email address, a confirmation email will be sent.",
        "invalid" => "Unable to create the account. Review the validation messages and try again.",
        _ => null
    };

    private IReadOnlyList<string> ValidationMessages => (Errors ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(code => code switch
        {
            "name" => "Enter a name of 100 characters or fewer.",
            "email" => "Enter a valid email address no longer than 256 characters.",
            "country" => "Country must be 100 characters or fewer.",
            "state" => "State or province must be 100 characters or fewer.",
            "username" => "Enter a username of 256 characters or fewer using permitted characters.",
            "password" => "Password must be 8–256 characters and include an uppercase letter, a lowercase letter, a number, and a symbol.",
            "confirm-password" => "The password and confirmation do not match.",
            "account-details" => "Unable to register using those account details. Check the username/email and try different details.",
            "form" => "Review the required fields and correct the indicated values.",
            _ => null
        })
        .Where(message => message is not null)
        .Select(message => message!)
        .Distinct()
        .ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _registrationFormModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/registration-form.js");
        await _registrationFormModule.InvokeVoidAsync(
            "initialize",
            _registrationForm,
            Status is not null,
            RateLimitUntil ?? 0);
    }

    public async ValueTask DisposeAsync()
    {
        if (_registrationFormModule is not null)
        {
            try
            {
                await _registrationFormModule.InvokeVoidAsync("dispose", _registrationForm);
                await _registrationFormModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
