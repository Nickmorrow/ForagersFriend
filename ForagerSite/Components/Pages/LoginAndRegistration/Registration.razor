@page "/Registration"
@using ForagerSite.DataContainer;
@using ForagerSite.Services;
@using ForagerSite.Services.Interfaces
@inject IUserService userService
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<PageTitle>Registration</PageTitle>

<h3>Registration</h3>

<div>
    <EditForm Model="@registrationInput" OnValidSubmit="_HandleValidSubmit" FormName="userForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label for="NameInput">Name</label>
        <InputText id="NameInput" @bind-Value="@registrationInput.Name"></InputText>   

        <label for="EmailInput">Email</label>
        <InputText id="EmailInput" @bind-Value="@registrationInput.Email"></InputText>
        <Microsoft.AspNetCore.Components.Forms.ValidationMessage For="@(() => registrationInput.Email)" />

        <label for="CountryInput">Country</label>
        <InputText id="CountryInput" @bind-Value="@registrationInput.Country"></InputText>

        <label for="StateInput">State or Province</label>
        <InputText id="StateInput" @bind-Value="@registrationInput.StateOrProvince"></InputText>

        <label for="UserNameInput">Username</label>
        <InputText id="UserNameInput" @bind-Value="@registrationInput.Username"></InputText>
        <Microsoft.AspNetCore.Components.Forms.ValidationMessage For="@(() => registrationInput.Username)" />

        <label for="PasswordInput">Password</label>
        <InputText id="PasswordInput" @bind-Value="@registrationInput.Password" type="@passwordInputType"></InputText>
        <Microsoft.AspNetCore.Components.Forms.ValidationMessage For="@(() => registrationInput.Password)" />

        <label for="ConfirmPasswordInput">Confirm Password</label>
        <InputText id="ConfirmPasswordInput" @bind-Value="@registrationInput.ConfirmPassword" type="@passwordInputType"></InputText>
        <Microsoft.AspNetCore.Components.Forms.ValidationMessage For="@(() => registrationInput.ConfirmPassword)" />

        <input type="checkbox" id="ShowPassword" @bind="showPassword" />
        <label for="ShowPassword">Show Password</label>
        

        <button type="submit" class="btn-primary">Add</button>
    </EditForm>

    <NavLink href="/Login">Back</NavLink>

    @if (_errorMessage != null)
    {
        <p style="color: red;">@_errorMessage</p>
    }
</div>

@code {

    private RegistrationInputModel registrationInput = new();

    private bool showPassword;
    private string passwordInputType => showPassword ? "text" : "password";

    private string _errorMessage;

    private bool _userNameExists;

    private bool _userEmailExists;

    private async Task _HandleValidSubmit(EditContext editContext)
    {
        _errorMessage = null;
        _userNameExists = await userService.UsernameExists(registrationInput.Username);
        _userEmailExists = await userService.EmailExists(registrationInput.Email);

        #region Validation Messages
        if (_userNameExists && _userEmailExists)
        {
            _errorMessage = "Username and Email already exist.";
            return;
        }
        if (_userNameExists)
        {
            _errorMessage = "Username already exists.";
            return;
        }
        if (_userEmailExists)
        {                          
            _errorMessage = "Email already exists.";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationInput.Email))
        {
            _errorMessage = "You must enter an Email address.";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationInput.Username))
        {
            _errorMessage = "You must enter a username.";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationInput.Password))
        {
            _errorMessage = "You must enter a password.";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationInput.ConfirmPassword))
        {
            _errorMessage = "Please confirm password.";
            return;
        }
        #endregion

        userService.AddUser(registrationInput);
        registrationInput = new RegistrationInputModel();
        navigationManager.NavigateTo("/");
    }
}
