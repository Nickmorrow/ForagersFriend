@page "/RecoverLoginInfo"
<PageTitle>RecoverLoginInfo</PageTitle>

<h3>Recover account access</h3>

<p>Enter the email address associated with your account. We will send instructions if it matches an eligible account.</p>

<form method="post" action="/account/recover">
    <AntiforgeryToken />
    <label for="password-email">Email address</label>
    <input id="password-email" name="Email" type="email" maxlength="256" required />
    <input type="hidden" name="RequestType" value="password" />
    <button type="submit">Reset password</button>
</form>

<form method="post" action="/account/recover">
    <AntiforgeryToken />
    <label for="username-email">Email address</label>
    <input id="username-email" name="Email" type="email" maxlength="256" required />
    <input type="hidden" name="RequestType" value="username" />
    <button type="submit">Recover username</button>
</form>

@if (Status == "acknowledged")
{
    <p role="status">If an eligible account matches that email address, instructions will be sent.</p>
}
else if (Status == "reset-invalid")
{
    <p role="status">This password reset link is invalid or expired. Request a new one and try again.</p>
}

<NavLink href="/Login">Back to sign in</NavLink>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }
}
