@page "/map"

@using DataAccess.Models
@using ForagerSite.Components.Find
@using ForagerSite.DataContainer
@using ForagerSite.Services
@using ForagerSite.Services.Interfaces
@using ForagerSite.Features.Map
@using ForagerSite.Features.Finds
@using Microsoft.AspNetCore.WebUtilities
@using Newtonsoft.Json
@using Utilities
@using NetTopologySuite.Geometries
@using NetTopologySuite.IO

@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS
@inject IConfiguration config
@inject IUserSessionService session
@inject IUserService userService
@inject MapFindQueries mapFindQueries
@inject FindQueries findQueries
@inject IMapService mapService
@inject IFriendService friendService
@inject NavigationManager Nav
@inject LocationIndexService geoIndex

<div>
    <MapSearch OnSearch="HandleSearch" />

    <div id="map-container" style="display: flex; height: 800px;">
        <div id="map" style="flex: 2; height: 100%;"></div>

        <MapFindsPanel 
                      IsLoading="isLoading"
                      hasLoaded="hasLoaded"
                      Pins="pins"
                      HasMorePins="hasMorePins"
                      OnFindsChanged="RefreshViewportPinsAsync"
                       />

    </div>
</div>

@* Template for map.js popup *@
<div id="find-popup-template" style="display: none;">
    <p><strong></strong> {findName}</p>
    @* <p><strong>Discovered by:</strong> {username}</p> *@
    <div id="photo-gallery">
        {Images}
    </div>
    @* <p><strong></strong> {speciesType}</p>
    <p><strong>Category: </strong> {useCategory}</p> *@
</div>



@code {
    private DotNetObjectReference<IMapService>? _mapServiceReference;
    #region Initialize map + load data
    private bool isLoading = false;
    private bool hasLoaded = false;
    private bool hasMorePins;
    private Guid? focusFindId;
    private Guid? focusUserId;
    private Guid _currentUserId;
    private string _currentUsername = "(unknown)";
    private string mapFilter = "AllUsers";
    private IReadOnlyList<MapPin> pins = Array.Empty<MapPin>();
    private UserFindsDataContainer? focusedFindDetail;
    private MapSearch.MapSearchCriteria activeCriteria = new();
    private GeoPolyRecord? activeLocation;
    private Geometry? activeBoundary;
    private CancellationTokenSource? viewportRequestCts;
    private long viewportRequestVersion;

    private static readonly JsonSerializerSettings MapJsonSettings = new()
    {
        ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver()
    };

    protected override void OnInitialized()
    {
        mapService.ViewportChanged += HandleViewportChanged;
    }

    private static bool IsInsideBoundary(Geometry boundary, double latitude, double longitude)
    {
        var point = boundary.Factory.CreatePoint(new Coordinate(longitude, latitude));
        return boundary.Covers(point);
    }

    private void ReadFocusFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("focusFindId", out var val) &&
            Guid.TryParse(val.ToString(), out var id))
        {
            focusFindId = id;
        }
        if (query.TryGetValue("focusUserId", out var uval) &&
            Guid.TryParse(uval.ToString(), out var uid))
        {
            focusUserId = uid;
        }

    }
    private async Task FocusFindIfRequested()
    {
        if (!focusFindId.HasValue)
            return;

        var find = focusedFindDetail?.finds.FirstOrDefault(item => item.findId == focusFindId.Value);
        if (find?.findLocation != null)
        {
            await mapService.OnMarkerClicked(focusFindId.Value.ToString());
        }

        focusFindId = null;
        focusedFindDetail = null;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            ReadFocusFromQuery();

            // ✅ Guard: session / user not ready (common on first load or unauth)
            var sessionUserId = session?.SessionUser?.UserId;
            if (sessionUserId == null || sessionUserId == Guid.Empty)
            {
                Console.WriteLine("Map: session user not available yet.");
                return;
            }

            var userVm = await userService.GetUserViewModelById(sessionUserId.Value);
            if (userVm?.user == null)
            {
                Console.WriteLine("Map: userVm or userVm.user was null.");
                return;
            }

            isLoading = true;
            StateHasChanged();

            _currentUserId = userVm.user.UsrId;
            _currentUsername = userVm.user.UserSecurity?.UssUsername ?? "(unknown)";
            _mapServiceReference = DotNetObjectReference.Create(mapService);

            if (focusFindId.HasValue)
                focusedFindDetail = await findQueries.GetFindDetailByIdAsync(focusFindId.Value);

            var focusedLocation = focusedFindDetail?.finds.FirstOrDefault()?.findLocation;

            mapFilter = "AllUsers";

            await JS.InvokeVoidAsync("setDotNetObjectReference", _mapServiceReference);
            await JS.InvokeVoidAsync(
                "initializeMap",
                "[]",
                _currentUserId.ToString(),
                mapFilter,
                _currentUsername,
                focusedLocation?.latitude,
                focusedLocation?.longitude
            );

            if (focusFindId.HasValue)
                await FocusFindIfRequested();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Map OnAfterRenderAsync failed: " + ex);
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
            StateHasChanged();
        }
    }



    #endregion
    #region Search / filters (called by MapSearch)
    private static bool HasSubcategory(string? stored, string? selected)
    {
        if (string.IsNullOrWhiteSpace(selected)) return true;      // no filter
        if (string.IsNullOrWhiteSpace(stored)) return false;

        var sel = selected.Trim();

        return stored
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Any(s => s.Equals(sel, StringComparison.OrdinalIgnoreCase));
    }

    private static bool PassesCreateDateFilter(MapPin pin, MapSearch.MapSearchCriteria criteria)
    {
        DateTime? created = pin.FindDate;

        if (string.IsNullOrWhiteSpace(criteria.DateMode) || criteria.DateMode == "Any")
            return true;

        if (created == null)
            return false;

        var d = created.Value.Date;

        if (criteria.DateMode == "Exact")
        {
            if (criteria.DateExact == null) return true;
            return d == criteria.DateExact.Value.Date;
        }

        if (criteria.DateMode == "Range")
        {
            if (criteria.DateFrom != null && d < criteria.DateFrom.Value.Date) return false;
            if (criteria.DateTo != null && d > criteria.DateTo.Value.Date) return false;
            return true;
        }

        if (criteria.DateMode == "Months")
        {
            if (criteria.Months == null || criteria.Months.Count == 0) return true;
            return criteria.Months.Contains(created.Value.Month);
        }

        return true;
    }


    private Task HandleViewportChanged(double south, double west, double north, double east) =>
        InvokeAsync(() => LoadViewportPinsAsync(new MapViewport(south, west, north, east)));

    private async Task LoadViewportPinsAsync(MapViewport viewport)
    {
        viewportRequestCts?.Cancel();
        viewportRequestCts?.Dispose();
        viewportRequestCts = new CancellationTokenSource();

        var cancellationToken = viewportRequestCts.Token;
        var requestVersion = ++viewportRequestVersion;
        isLoading = true;
        StateHasChanged();

        try
        {
            var page = await mapFindQueries.GetViewportPinsAsync(
                new MapPinRequest(viewport, GetActiveScope()),
                cancellationToken);

            if (cancellationToken.IsCancellationRequested || requestVersion != viewportRequestVersion)
                return;

            hasMorePins = page.HasMore;
            pins = ApplySearchFilters(page.Pins, activeCriteria).ToList();
            var json = JsonConvert.SerializeObject(pins, MapJsonSettings);

            await JS.InvokeVoidAsync(
                "updateMapPins",
                cancellationToken,
                json,
                _currentUserId.ToString(),
                mapFilter,
                _currentUsername);

            hasLoaded = true;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            if (requestVersion == viewportRequestVersion)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private MapFindScope GetActiveScope() => new(
        activeCriteria.IncludeMyFinds,
        activeCriteria.IncludeFriendsFinds);

    private Task RefreshViewportPinsAsync() =>
        JS.InvokeVoidAsync("requestViewportRefresh").AsTask();

    private IEnumerable<MapPin> ApplySearchFilters(
        IEnumerable<MapPin> source,
        MapSearch.MapSearchCriteria criteria)
    {
        var results = source;

        if (!string.IsNullOrWhiteSpace(criteria.UserSearchTerm))
        {
            results = results.Where(pin =>
                pin.OwnerName.Contains(criteria.UserSearchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (activeLocation is not null && activeBoundary is not null)
        {
            results = results.Where(pin =>
                pin.Longitude >= activeLocation.West && pin.Longitude <= activeLocation.East &&
                pin.Latitude >= activeLocation.South && pin.Latitude <= activeLocation.North &&
                IsInsideBoundary(activeBoundary, pin.Latitude, pin.Longitude));
        }

        if (!string.IsNullOrWhiteSpace(criteria.SelectedSpeciesType) ||
            !string.IsNullOrWhiteSpace(criteria.SelectedUseCategory) ||
            !string.IsNullOrWhiteSpace(criteria.KeywordSearchTerm))
        {
            results = results.Where(pin =>
                (string.IsNullOrWhiteSpace(criteria.SelectedSpeciesType) ||
                    string.Equals(pin.SpeciesType, criteria.SelectedSpeciesType, StringComparison.OrdinalIgnoreCase)) &&
                HasSubcategory(pin.UseCategory, criteria.SelectedUseCategory) &&
                (string.IsNullOrWhiteSpace(criteria.KeywordSearchTerm) ||
                    (pin.Name ?? string.Empty).StartsWith(criteria.KeywordSearchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(criteria.DateMode) && criteria.DateMode != "Any")
            results = results.Where(pin => PassesCreateDateFilter(pin, criteria));

        return results;
    }

    private async Task HandleSearch(MapSearch.MapSearchCriteria criteria)
    {
        activeCriteria = criteria;
        mapFilter = criteria.IncludeMyFinds && !criteria.IncludeFriendsFinds
            ? "UserOnly"
            : criteria.IncludeFriendsFinds && !criteria.IncludeMyFinds
                ? "FriendUsers"
                : "AllUsers";
        activeLocation = null;
        activeBoundary = null;

        if (!string.IsNullOrWhiteSpace(criteria.LocationKind) &&
            !string.IsNullOrWhiteSpace(criteria.LocationId))
        {
            activeLocation = geoIndex.GetByKindAndId(criteria.LocationKind, criteria.LocationId);
            if (activeLocation is not null)
            {
                var geometryJson = activeLocation.Feature.GetProperty("geometry").GetRawText();
                activeBoundary = new GeoJsonReader().Read<Geometry>(geometryJson);
                await JS.InvokeVoidAsync("clearSearchBounds");
                await JS.InvokeVoidAsync("drawGeoBoundaryFromJson", activeLocation.Feature.GetRawText());
            }
        }

        if (activeLocation is null)
        {
            await JS.InvokeVoidAsync("clearGeoBoundary");
            await JS.InvokeVoidAsync("clearSearchBounds");
        }

        await JS.InvokeVoidAsync("requestViewportRefresh");
    }


    #endregion

    public void Dispose()
    {
        mapService.ViewportChanged -= HandleViewportChanged;
        viewportRequestCts?.Cancel();
        viewportRequestCts?.Dispose();
        _mapServiceReference?.Dispose();
    }
}
