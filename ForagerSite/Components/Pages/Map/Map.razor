@page "/map"

@using DataAccess.Models
@using ForagerSite.Components.Find
@using ForagerSite.DataContainer
@using ForagerSite.Services
@using ForagerSite.Services.Interfaces
@using Microsoft.AspNetCore.WebUtilities
@using Newtonsoft.Json
@using Utilities
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IConfiguration config
@inject IUserSessionService session
@inject IUserService userService
@inject IUserFindService userFindService
@inject IMapService mapService
@inject IFriendService friendService
@inject NavigationManager Nav

<div>
    <MapSearch OnSearch="HandleSearch" />

    <div id="map-container" style="display: flex; height: 800px;">
        <div id="map" style="flex: 2; height: 100%;"></div>

        <MapFindsPanel 
                      IsLoading="isLoading"
                      hasLoaded="hasLoaded"
                       />

    </div>
</div>

@* Template for map.js popup *@
<div id="find-popup-template" style="display: none;">
    <p><strong></strong> {findName}</p>
    @* <p><strong>Discovered by:</strong> {username}</p> *@
    <div id="photo-gallery">
        {Images}
    </div>
    @* <p><strong></strong> {speciesType}</p>
    <p><strong>Category: </strong> {useCategory}</p> *@
</div>



@code {
    private DotNetObjectReference<IMapService> _mapServiceReference;
    #region Initialize map + load data
    private bool isLoading = false;
    private bool hasLoaded = false;
    private Guid? focusFindId;
    private Guid? focusUserId;
    // private bool _mapInitialized;


    private void ReadFocusFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("focusFindId", out var val) &&
            Guid.TryParse(val.ToString(), out var id))
        {
            focusFindId = id;
        }
        if (query.TryGetValue("focusUserId", out var uval) &&
            Guid.TryParse(uval.ToString(), out var uid))
        {
            focusUserId = uid;
        }

    }
    private async Task WaitForMapReady()
    {
        // ~2 seconds max, checks every 50ms
        for (int i = 0; i < 40; i++)
        {
            var ready = await JS.InvokeAsync<bool>("isForagerMapReady");
            if (ready) return;
            await Task.Delay(50);
        }
    }

    private bool TryGetLatLngForFind(Guid findId, List<UserFindsDataContainer> vms, out double lat, out double lng)
    {
        lat = 0;
        lng = 0;

        var find = vms
            .SelectMany(vm => vm.finds)
            .FirstOrDefault(f => f.findId == findId);

        if (find?.findLocation == null)
            return false;

        lat = find.findLocation.latitude;
        lng = find.findLocation.longitude;
        return true;
    }

    private async Task FocusFindIfRequested(UserDataContainer userVm)
    {
        if (!focusFindId.HasValue)
            return;

        // Try current dataset first
        if (TryGetLatLngForFind(focusFindId.Value, mapService.CurrentViewModels, out var lat, out var lng))
        {
            await JS.InvokeVoidAsync("focusFindAfterDelay", lat, lng, 20);
            focusFindId = null;
            return;
        }

        // Not found => switch to AllUsers, rebuild markers, then focus
        mapService.mapFilter = "AllUsers";

        if (!mapService.AllViewModels.Any())
            mapService.AllViewModels = await userFindService.GetUserFindsDCsAll();

        mapService.CurrentViewModels = VmUtilities.Copy(mapService.AllViewModels);
        FilterAccessibility(mapService.CurrentViewModels, userVm.user.UsrId);

        var json = JsonConvert.SerializeObject(
            mapService.CurrentViewModels,
            new JsonSerializerSettings
            {
                ReferenceLoopHandling = ReferenceLoopHandling.Ignore,
                Formatting = Formatting.Indented
            });

        await JS.InvokeVoidAsync(
            "initializeMap",
            json,
            userVm.user.UsrId.ToString(),
            mapService.mapFilter,
            userVm.user.UserSecurity.UssUsername);

        if (TryGetLatLngForFind(focusFindId.Value, mapService.CurrentViewModels, out lat, out lng))
        {
            await JS.InvokeVoidAsync("focusFindAfterDelay", lat, lng, 20);
        }

        focusFindId = null;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            ReadFocusFromQuery();

            // ✅ Guard: session / user not ready (common on first load or unauth)
            var sessionUserId = session?.SessionUser?.UserId;
            if (sessionUserId == null || sessionUserId == Guid.Empty)
            {
                Console.WriteLine("Map: session user not available yet.");
                return;
            }

            var userVm = await userService.GetUserViewModelById(sessionUserId.Value);
            if (userVm?.user == null)
            {
                Console.WriteLine("Map: userVm or userVm.user was null.");
                return;
            }

            isLoading = true;
            StateHasChanged();

            _mapServiceReference = DotNetObjectReference.Create(mapService);

            mapService.userNamesKvp = await userFindService.GetCommentUserNames();

            // ✅ Guard: lists should never be null
            mapService.AllViewModels ??= new();
            mapService.CurrentViewModels ??= new();
            mapService.MyViewModels ??= new();

            var shouldLoadAllUsers =
                focusUserId.HasValue && focusUserId.Value != userVm.user.UsrId;

            //if (shouldLoadAllUsers)
            //{
                mapService.mapFilter = "AllUsers";

                if (!mapService.AllViewModels.Any())
                    mapService.AllViewModels = await userFindService.GetUserFindsDCsAll();

                mapService.CurrentViewModels = VmUtilities.Copy(mapService.AllViewModels);

                FilterAccessibility(mapService.CurrentViewModels, userVm.user.UsrId);
            //}
            // else
            // {
            //     mapService.mapFilter = "UserOnly";

            //     mapService.CurrentViewModels =
            //         await userFindService.GetUserFindsDCsUser(userVm.user.UsrId);

            //     mapService.MyViewModels = VmUtilities.Copy(mapService.CurrentViewModels);
            // }

            var json = JsonConvert.SerializeObject(
                mapService.CurrentViewModels ?? new(),
                new JsonSerializerSettings
                {
                    ReferenceLoopHandling = ReferenceLoopHandling.Ignore,
                    Formatting = Formatting.Indented
                });

            // ✅ Guard username (don’t assume UserSecurity is loaded)
            var username = userVm.user.UserSecurity?.UssUsername ?? "(unknown)";

            await JS.InvokeVoidAsync("setDotNetObjectReference", _mapServiceReference);
            await JS.InvokeVoidAsync(
                "initializeMap",
                json,
                userVm.user.UsrId.ToString(),
                mapService.mapFilter,
                username
            );

            await FocusFindIfRequested(userVm);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Map OnAfterRenderAsync failed: " + ex);
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
            StateHasChanged();
        }
    }



    #endregion
    #region Search / filters (called by MapSearch)
    private async Task EnsureScopeLoaded(string scope, UserDataContainer userVm)
    {
        // Keep mapService.mapFilter in sync with UI
        mapService.mapFilter = scope;

        if (scope == "AllUsers")
        {
            if (!mapService.AllViewModels.Any())
                mapService.AllViewModels = await userFindService.GetUserFindsDCsAll();

            mapService.CurrentViewModels = VmUtilities.Copy(mapService.AllViewModels);
            FilterAccessibility(mapService.CurrentViewModels, userVm.user.UsrId);
            return;
        }

        if (scope == "UserOnly")
        {
            if (!mapService.MyViewModels.Any())
                mapService.MyViewModels = await userFindService.GetUserFindsDCsUser(userVm.user.UsrId);

            mapService.CurrentViewModels = VmUtilities.Copy(mapService.MyViewModels);
            return;
        }

        if (scope == "FriendUsers")
        {
            if (mapService.FriendCacheOwnerUserId != userVm.user.UsrId)
                mapService.ClearFriendCache(userVm.user.UsrId);

            if (!mapService.FriendViewModels.Any())
            {
                var friends = await friendService.GetFriends(userVm.user.UsrId);
                var friendIds = friends.Select(f => f.UserId).ToList();
                mapService.FriendViewModels = await userFindService.GetUserFindsDCs(friendIds);
            }

            mapService.CurrentViewModels = VmUtilities.Copy(mapService.FriendViewModels);
            FilterAccessibility(mapService.CurrentViewModels, userVm.user.UsrId);
            return;
        }
    }

    private void FilterAccessibility(List<UserFindsDataContainer> currentViewModels, Guid userId)
    {
        foreach (var vm in currentViewModels)
        {
            if (vm.userId != userId)
            {
                vm.finds = vm.finds
                    .Where(f => f.accessibility != "Private")
                    .ToList(); // TODO: friends-only in future
            }
        }
    }

    private static bool HasSubcategory(string? stored, string? selected)
    {
        if (string.IsNullOrWhiteSpace(selected)) return true;      // no filter
        if (string.IsNullOrWhiteSpace(stored)) return false;

        var sel = selected.Trim();

        return stored
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Any(s => s.Equals(sel, StringComparison.OrdinalIgnoreCase));
    }

    private async Task HandleSearch(MapSearch.MapSearchCriteria criteria)
    {
        var userVm = await userService.GetUserViewModelById(session.SessionUser.UserId);
        if (userVm?.user == null)
            return;

        var settings = new JsonSerializerSettings
        {
            ReferenceLoopHandling = ReferenceLoopHandling.Ignore,
            Formatting = Formatting.Indented
        };

        // Start from baseline based on selected scope (All/My/Friends)
        var scope = string.IsNullOrWhiteSpace(criteria.Scope) ? "AllUsers" : criteria.Scope;
        await EnsureScopeLoaded(scope, userVm);

        // Filter by user name
        if (!string.IsNullOrEmpty(criteria.UserSearchTerm))
        {
            mapService.CurrentViewModels = mapService.CurrentViewModels
                .Where(vm => vm.userName.Contains(criteria.UserSearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (criteria.West.HasValue && criteria.South.HasValue && criteria.East.HasValue && criteria.North.HasValue)
        {
            double west = criteria.West.Value;
            double south = criteria.South.Value;
            double east = criteria.East.Value;
            double north = criteria.North.Value;

            foreach (var vm in mapService.CurrentViewModels)
            {
                vm.finds = vm.finds
                    .Where(f =>
                        f.findLocation != null &&
                        f.findLocation.longitude >= west && f.findLocation.longitude <= east &&
                        f.findLocation.latitude >= south && f.findLocation.latitude <= north)
                    .ToList();
            }

            await JS.InvokeVoidAsync("drawSearchBounds", west, south, east, north);
        }
        else
        {
            // Optional: clear the previous border if user clears location
            await JS.InvokeVoidAsync("clearSearchBounds");
        }

        // Filter by species / category / keyword (keyword optional)
        if (!string.IsNullOrEmpty(criteria.SelectedSpeciesType)
            || !string.IsNullOrEmpty(criteria.SelectedUseCategory)
            || !string.IsNullOrEmpty(criteria.KeywordSearchTerm))
        {
            foreach (var vm in mapService.CurrentViewModels)
            {
                vm.finds = vm.finds
                    .Where(f =>
                        (string.IsNullOrEmpty(criteria.SelectedSpeciesType) ||
                            f.speciesType.Equals(criteria.SelectedSpeciesType, StringComparison.OrdinalIgnoreCase))
                        && HasSubcategory(f.useCategory, criteria.SelectedUseCategory)
                        && (string.IsNullOrEmpty(criteria.KeywordSearchTerm) ||
                            f.findName.Contains(criteria.KeywordSearchTerm, StringComparison.OrdinalIgnoreCase))
                    )
                    .ToList();

            }
        }

        var json = JsonConvert.SerializeObject(mapService.CurrentViewModels, settings);
        var username = userVm.user.UserSecurity?.UssUsername ?? "(unknown)";
        await JS.InvokeVoidAsync("initializeMap", json, userVm.user.UsrId.ToString(), mapService.mapFilter, username);

        // If a location bbox is selected, zoom + center so it fills the map
        if (criteria.South.HasValue && criteria.West.HasValue &&
            criteria.North.HasValue && criteria.East.HasValue)
        {
            await JS.InvokeVoidAsync("drawSearchBounds",
                criteria.South.Value, criteria.West.Value,
                criteria.North.Value, criteria.East.Value);

            await JS.InvokeVoidAsync("fitMapToBbox",
                criteria.South.Value, criteria.West.Value,
                criteria.North.Value, criteria.East.Value);

            await JS.InvokeVoidAsync("lockMapToBbox",
                criteria.South.Value, criteria.West.Value,
                criteria.North.Value, criteria.East.Value);

        }
        else
        {
            // no location filter => remove outline
            await JS.InvokeVoidAsync("clearSearchBounds");
            await JS.InvokeVoidAsync("unlockMapBounds");

        }

    }
    #endregion

    public void Dispose()
    {
        _mapServiceReference?.Dispose();
    }
}
