@using ForagerSite.DataContainer
@using ForagerSite.Services.Interfaces
@using ForagerSite.Components.Find
@using Newtonsoft.Json
@using Utilities
@implements IDisposable
@inject IUserSessionService session
@inject IMapService mapService
@inject IJSRuntime JSRuntime
@inject IUserService userService
@inject NavigationManager navigationManager

<div class="finds-panel @(isSidebarExpanded ? "expanded" : "collapsed")">
    @if (isSidebarExpanded)
    {
        <div class="finds-panel-header">
            @* <strong>Finds</strong> *@
            <button class="btn btn-sm btn-light"
                    aria-label="Collapse finds sidebar"
                    title="Collapse finds sidebar"
                    @onclick="ToggleSidebar">‹</button>
        </div>
        <div class="finds-panel-body">
            @if (isLoading && !hasLoaded)
            {
                <div class="loading-indicator">
                    <p>Loading...</p>
                </div>
            }
            else if (hasLoaded)
            {
                <div id="finds-grid" class="finds-grid">
                    <div class="finds-grid-heading">
                        <h5>Finds</h5>
                        <span>@VisibleFinds.Count() shown</span>
                    </div>

                    @if (!VisibleFinds.Any() && !showCreateForm)
                    {
                        <p class="finds-empty-state">No finds match the current filters.</p>
                    }
                    else
                    {
                        <table class="finds-table">
                            <tbody>
                                @if (showCreateForm)
                                {
                                    <tr id="create-form-row">
                                        <td colspan="4" class="find-create-cell">
                                            <h5>Create Find</h5>
                                            <FindCreateForm OnClose="CloseCreateForm"
                                                            OnCreated="CloseCreateForm"
                                                            OnFindCreated="HandleFindCreated" />
                                        </td>
                                    </tr>
                                }

                                @foreach (var item in VisibleFinds)
                                {
                                    var find = item.Find;
                                    var vm = item.ViewModel;
                                    var isExpanded = expandedFindId == find.findId;

                                    <tr id="find-row-@find.findId"
                                        class="find-summary-row @(isExpanded ? "expanded" : null)"
                                        role="button"
                                        tabindex="0"
                                        aria-expanded="@isExpanded"
                                        @onclick="() => ToggleFind(vm, find)"
                                        @onkeydown="e => HandleFindRowKeyDown(e, vm, find)">
                                        <td class="find-name-cell">
                                            <strong>@find.findName</strong>
                                            @if (!string.IsNullOrWhiteSpace(find.speciesName))
                                            {
                                                <small>@find.speciesName</small>
                                            }
                                        </td>
                                        <td class="find-image-cell">
                                            @if (!isExpanded && find.findImages != null && find.findImages.Any())
                                            {
                                                <img src="@find.findImages.First().imageData" alt="@find.findName" />
                                            }
                                            else if (!isExpanded)
                                            {
                                                <span>No image available</span>
                                            }
                                        </td>
                                        <td class="find-category-cell">@if (!isExpanded)
                                            {
                                                @find.speciesType
                                            }
                                        </td>
                                        @* <td class="find-grid-discoverer">
                                            <div class="find-discoverer-summary">
                                                <img src="@vm.profilePic" alt="Profile Picture" />
                                                <span>Discovered by<br />@vm.userName</span>
                                            </div>
                                        </td> *@
                                    </tr>

                                    @if (isExpanded)
                                    {
                                        <tr class="find-details-row">
                                            <td colspan="4">
                                                <div class="find-details">
                                        @if (showEditForm && currentEditModel != null && currentEditModel.FindId == find.findId)
                                        {
                                            <FindEditForm @key="currentEditModel.FindId"
                                                          Model="currentEditModel"
                                                          OnClose="CloseEditForm"
                                                          OnUpdated="CloseEditForm"
                                                          OnFindUpdated="HandleFindUpdated" />
                                        }
                                        else
                                        {
                                            <div class="find-discoverer">
                                                <img src="@vm.profilePic"
                                                     alt="Profile Picture"
                                                     style="width:50px; height:50px; border-radius:50%; object-fit:cover;" />
                                                <div>
                                                    <div style="font-weight:600;">Discovered by</div>
                                                    <a href="/profile/@vm.userId"
                                                       @onclick:stopPropagation="true"
                                                       @onclick:preventDefault="true"
                                                       @onclick="() => GoToProfile(vm.userId)"
                                                       style="cursor:pointer; text-decoration:underline;">
                                                        @vm.userName
                                                    </a>
                                                </div>
                                            </div>
                                            <p>@find.findDate.ToString("MMMM dd, yyyy")</p>
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => GetDirections(find.findLocation.latitude, find.findLocation.longitude)">
                                                📍 Get Directions
                                            </button>
                                            <button class="btn btn-sm btn-link"
                                                    @onclick="() => ViewOnMap(find)">
                                                View on map
                                            </button>
                                            @if (find.findImages != null && find.findImages.Any())
                                            {
                                                <FindImageGallery Images="find.findImages" />
                                            }
                                            else
                                            {
                                                <p><em>No images uploaded.</em></p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(find.speciesName))
                                            {
                                                <p><strong>Species Name:</strong> @find.speciesName</p>
                                            }
                                            <p><strong>Category:</strong> @find.speciesType</p>
                                            <p><strong>SubCategory: </strong> @find.useCategory</p>

                                            @if (!string.IsNullOrWhiteSpace(find.features))
                                            {
                                                <p><strong>Distinguishing Features:</strong> @find.features</p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(find.lookAlikes))
                                            {
                                                <p><strong>Dangerous Lookalikes:</strong> @find.lookAlikes</p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(find.harvestMethod))
                                            {
                                                <p><strong>Harvest Method:</strong> @find.harvestMethod</p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(find.tastesLike))
                                            {
                                                <p><strong>Tastes like:</strong> @find.tastesLike</p>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(find.description))
                                            {
                                                <p><strong>Notes:</strong> @find.description</p>
                                            }

                                            @if (find.findUserId == session.SessionUser.UserId)
                                            {
                                                <p><strong>Who can see this?</strong> @find.accessibility</p>
                                            }

                                            <Vote find="find"
                                                  comment="@null"
                                                  vmUserId="vm.userId"
                                                  findOrCommentId="find.findId"
                                                  voteType="find" />

                                            @if (find.findUserId == session.SessionUser.UserId)
                                            {
                                                <div class="find-actions">
                                                    <button class="btn btn-secondary" @onclick="() => OpenEdit(find)">Edit</button>
                                                    <button class="btn btn-danger" @onclick="() => HandleFindDeleted(find.findId)">Delete</button>
                                                </div>
                                            }

                                            <CommentThread @key="find.findId"
                                                           Find="find"
                                                           VmId="vm.userId"
                                                           CurrentUserId="session.SessionUser.UserId"
                                                           UserNames="mapService.userNamesKvp" />
                                        }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    }
                }
                </div>
            }
        </div>
    }
    else
    {
        <button class="sidebar-expand-button"
                aria-label="Expand finds sidebar"
                title="Expand finds sidebar"
                @onclick="ToggleSidebar">›</button>
    }
</div>

@code {
    [Parameter] public bool isLoading { get; set; }
    [Parameter] public bool hasLoaded { get; set; }
    [Parameter] public List<UserFindsDataContainer>? Finds { get; set; }

    private bool showCreateForm = false;
    private bool showEditForm = false;
    private bool isSidebarExpanded = true;
    private bool pendingMapResize;
    private Guid? expandedFindId;
    private Guid? pendingScrollFindId;

    private FindEditForm.FindEditTemp? currentEditModel;

    private UserFindsDataContainer? selectedVm;
    private FindDC? selectedFind;

    private void GoToProfile(Guid userId)
    {
        navigationManager.NavigateTo($"/profile/{userId}");
    }


    private async Task ReInitializeMap()
    {
        var userVm = await userService.GetUserViewModelById(session.SessionUser.UserId);
        if (userVm == null) return;

        var json = JsonConvert.SerializeObject(
            mapService.CurrentViewModels,
            new JsonSerializerSettings
            {
                ReferenceLoopHandling = ReferenceLoopHandling.Ignore,
                Formatting = Formatting.Indented
            });

        await JSRuntime.InvokeVoidAsync(
            "initializeMap",
            json,
            userVm.user.UsrId.ToString(),
            mapService.mapFilter,
            userVm.user.UserSecurity.UssUsername);
    }

    protected override void OnInitialized()
    {
        mapService.OnMarkerSelected += HandleMarkerSelected;
        mapService.OnCreateFormRequested += HandleCreateFormRequested;
    }

    public void Dispose()
    {
        mapService.OnMarkerSelected -= HandleMarkerSelected;
        mapService.OnCreateFormRequested -= HandleCreateFormRequested;
    }

    private IEnumerable<(UserFindsDataContainer ViewModel, FindDC Find)> VisibleFinds =>
        (Finds ?? mapService.CurrentViewModels)
            .Where(vm => vm.finds != null)
            .SelectMany(vm => vm.finds.Select(find => (ViewModel: vm, Find: find)));

    protected override void OnParametersSet()
    {
        if (expandedFindId.HasValue && !VisibleFinds.Any(item => item.Find.findId == expandedFindId.Value))
            ClosePanel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingMapResize)
        {
            pendingMapResize = false;
            await JSRuntime.InvokeVoidAsync("invalidateForagerMapSize");
        }

        if (pendingScrollFindId is Guid findId)
        {
            pendingScrollFindId = null;
            await JSRuntime.InvokeVoidAsync("scrollToFindRow", findId.ToString());
        }
    }

    private void ToggleSidebar()
    {
        isSidebarExpanded = !isSidebarExpanded;
        pendingMapResize = true;
    }

    private void ClosePanel()
    {
        showCreateForm = false;
        showEditForm = false;
        currentEditModel = null;
        selectedVm = null;
        selectedFind = null;
        expandedFindId = null;
    }

    private void ToggleFind(UserFindsDataContainer vm, FindDC find)
    {
        if (expandedFindId == find.findId)
        {
            ClosePanel();
            return;
        }

        selectedVm = vm;
        selectedFind = find;
        expandedFindId = find.findId;
        showEditForm = false;
        currentEditModel = null;
    }

    private void HandleFindRowKeyDown(KeyboardEventArgs args, UserFindsDataContainer vm, FindDC find)
    {
        if (args.Key is "Enter" or " ")
            ToggleFind(vm, find);
    }

    private void HandleCreateFormRequested()
    {
        showCreateForm = true;

        // clear selection/edit
        selectedVm = null;
        selectedFind = null;
        expandedFindId = null;
        showEditForm = false;
        currentEditModel = null;

        InvokeAsync(StateHasChanged);
    }

    private void HandleMarkerSelected(Guid findId)
    {
        _ = InvokeAsync(() =>
        {
            var vm = mapService.CurrentViewModels
                ?.FirstOrDefault(v => v.finds.Any(f => f.findId == findId));

            var find = vm?.finds.FirstOrDefault(f => f.findId == findId);
            if (vm == null || find == null)
                return;

            selectedVm = vm;
            selectedFind = find;
            expandedFindId = findId;
            pendingScrollFindId = findId;
            if (!isSidebarExpanded)
            {
                isSidebarExpanded = true;
                pendingMapResize = true;
            }
            showCreateForm = false;
            showEditForm = false;
            currentEditModel = null;

            StateHasChanged();
        });
    }

    private void OpenEdit(FindDC find)
    {
        selectedFind = find;
        if (selectedFind == null) return;

        currentEditModel = new FindEditForm.FindEditTemp
        {
            FindId = selectedFind.findId,
            FindName = selectedFind.findName,
            SpeciesName = selectedFind.speciesName,
            SpeciesType = selectedFind.speciesType,
            UseCategory = selectedFind.useCategory,
            Features = selectedFind.features,
            LookAlikes = selectedFind.lookAlikes,
            HarvestMethod = selectedFind.harvestMethod,
            TastesLike = selectedFind.tastesLike,
            Description = selectedFind.description,
            ExistingImageUrls = selectedFind.findImages.Select(img => img.imageData).ToList(),
            AccessLevel = selectedFind.accessibility
        };

        showEditForm = true;
    }

    private Task CloseEditForm()
    {
        showEditForm = false;
        currentEditModel = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CloseCreateForm()
    {
        showCreateForm = false;
        mapService.pendingLat = null;
        mapService.pendingLng = null;
    }

    private async Task ViewOnMap(FindDC find)
    {
        await JSRuntime.InvokeVoidAsync(
            "centerMapOnFind",
            find.findLocation.latitude,
            find.findLocation.longitude);
    }

    private async Task HandleFindCreated(FindCreateForm.FindTemp temp)
    {
        await mapService.CreateFindVm(
            temp.FindName,
            temp.SpeciesName,
            temp.SpeciesType,
            temp.UseCategory,
            temp.Features,
            temp.LookAlikes,
            temp.HarvestMethod,
            temp.TastesLike,
            temp.Description,
            mapService.pendingLat!.Value,
            mapService.pendingLng!.Value,
            temp.ImageUrls,
            temp.AccessLevel);

        CloseCreateForm();
        await ReInitializeMap();
        ClosePanel();
        // keep panel open, could also set selectedFind to the new one if you want
    }

    private async Task HandleFindUpdated(FindEditForm.FindEditTemp temp)
    {
        await mapService.UpdateFindVm(
            temp.FindId,
            temp.FindName,
            temp.SpeciesName ?? string.Empty,
            temp.SpeciesType,
            temp.UseCategory,
            temp.Features ?? string.Empty,
            temp.LookAlikes ?? string.Empty,
            temp.HarvestMethod ?? string.Empty,
            temp.TastesLike ?? string.Empty,
            temp.Description ?? string.Empty,
            temp.UploadedImageUrls,
            temp.DeletedImageUrls,
            temp.AccessLevel);

        showEditForm = false;
        currentEditModel = null;

        // refresh selectedFind from updated VMs
        HandleMarkerSelected(temp.FindId);
        await ReInitializeMap();
    }

    private async Task HandleFindDeleted(Guid findId)
    {
        await mapService.DeleteFindVm(findId);
        ClosePanel();
        await ReInitializeMap();
    }

    private async Task GetDirections(double lat, double lng)
    {
        await DirectionsHelper.OpenAsync(JSRuntime, lat, lng);
    }


}
