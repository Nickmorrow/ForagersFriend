@using ForagerSite.DataContainer
@using Microsoft.AspNetCore.Components.Web

<div tabindex="0"
     @onkeydown="HandleKeyDown"
     style="
        width:500px;
        height:500px;
        position:relative;
        overflow:hidden;
        border-radius:10px;
        border:1px solid rgba(0,0,0,0.15);
        background:#fff;">

    @if (Images == null || Images.Count == 0)
    {
        @if (ShowEmptyState)
        {
            <div class="text-muted"
                 style="display:flex; align-items:center; justify-content:center; height:100%;">
                No images
            </div>
        }
    }
    else
    {
        <!-- Image -->
        <img src="@Images[_activeIndex].imageData"
             alt="Find image"
             style="
                    width:100%;
                    height:100%;
                    object-fit:cover;
                    user-select:none;" />

        <!-- Left arrow -->
        <button type="button"
                title="Previous"
                @onclick="Prev"
                style="
                        position:absolute;
                        left:8px;
                        top:50%;
                        transform:translateY(-50%);
                        background:rgba(255,255,255,0.8);
                        border:none;
                        border-radius:999px;
                        width:36px;
                        height:36px;
                        cursor:pointer;">
            ◀
        </button>

        <!-- Right arrow -->
        <button type="button"
                title="Next"
                @onclick="Next"
                style="
                        position:absolute;
                        right:8px;
                        top:50%;
                        transform:translateY(-50%);
                        background:rgba(255,255,255,0.8);
                        border:none;
                        border-radius:999px;
                        width:36px;
                        height:36px;
                        cursor:pointer;">
            ▶
        </button>

        <!-- Counter -->
        <div style="
                position:absolute;
                bottom:6px;
                right:6px;
                background:rgba(0,0,0,0.6);
                color:#fff;
                font-size:12px;
                padding:4px 8px;
                border-radius:999px;">
            @(_activeIndex + 1) / @Images.Count
        </div>
    }
</div>

@code {
    [Parameter] public List<ImageDC>? Images { get; set; }
    [Parameter] public bool ShowEmptyState { get; set; } = true;

    private int _activeIndex = 0;

    protected override void OnParametersSet()
    {
        if (Images == null || Images.Count == 0)
        {
            _activeIndex = 0;
            return;
        }

        _activeIndex = Math.Clamp(_activeIndex, 0, Images.Count - 1);
    }

    private void Prev()
    {
        if (Images == null || Images.Count == 0) return;
        _activeIndex = (_activeIndex - 1 + Images.Count) % Images.Count;
    }

    private void Next()
    {
        if (Images == null || Images.Count == 0) return;
        _activeIndex = (_activeIndex + 1) % Images.Count;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Images == null || Images.Count == 0) return;

        if (e.Key == "ArrowLeft") Prev();
        else if (e.Key == "ArrowRight") Next();
    }
}
