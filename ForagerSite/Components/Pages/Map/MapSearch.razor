﻿@using ForagerSite.Services.Interfaces
@using ForagerSite.CommonRules.ForagerSite.CommonRules
@inject ForagerSite.Services.LocationIndexService geoIndex
@inject IUserService userService

<div id="search-container" class="mb-3" style="display:flex; flex-direction:column; gap:12px;">

    @* Main keyword search (always visible) *@
    <div style="display:flex; gap:12px; align-items:flex-end;">
        <div style="flex:1;">
            <label for="keyword-search">Search</label>
            <InputText id="keyword-search"
                       @bind-Value="keywordSearchTerm"
                       placeholder="Search by keyword (optional)…"
                       class="form-control" />
        </div>

        <div style="flex:1; position:relative;">
            <label for="location-search">Location</label>
            <InputText id="location-search"
                       @bind-Value="locationTerm"
                       placeholder="State, county, city…"
                       class="form-control"
                       @oninput="LocationInputChanged" />

            @if (locationSuggestions.Any())
            {
                <ul class="dropdown-menu show"
                    style="display:block; position:absolute; z-index:50; width:100%;">
                    @foreach (var s in locationSuggestions)
                    {
                        <li class="dropdown-item" @onclick="() => SelectLocation(s)">
                            @s.Display
                        </li>
                    }
                </ul>
            }
        </div>

        <button id="search-button"
                class="btn btn-primary"
                @onclick="SearchClicked">
            Search
        </button>

    </div>

    @* TODO: Tags filter *@
    <div>
        <button type="button"
            class="filters-btn"
            @onclick="ToggleFilters">
            <span class="filters-icon" aria-hidden="true">☰</span>
            <span>Filters</span>

            @if (ActiveFilterCount > 0)
            {
                <span class="filters-badge">@ActiveFilterCount</span>
            }
        </button>


        @if (areFiltersVisible)
        {
            <div id="filters-container" class="mt-2" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end;">

                <div>
                    <label class="d-block">Scope</label>

                    <label style="display:flex; gap:8px; align-items:center;">
                        <input type="checkbox" checked="@isAllFinds" @onchange="() => SetScope(ScopeSelection.AllUsers)" />
                        All Finds
                    </label>

                    <label style="display:flex; gap:8px; align-items:center;">
                        <input type="checkbox" checked="@isMyFinds" @onchange="() => SetScope(ScopeSelection.UserOnly)" />
                        My Finds
                    </label>

                    <label style="display:flex; gap:8px; align-items:center;">
                        <input type="checkbox" checked="@isFriendsFinds" @onchange="() => SetScope(ScopeSelection.FriendUsers)" />
                        Friends' Finds
                    </label>
                </div>

                <div>
                    <label for="species-dropdown">Category</label>
                    <select id="species-dropdown"
                            class="form-control"
                            @bind="selectedSpeciesType"
                            @bind:after="OnSpeciesTypeChanged">
                        <option value="">(Any)</option>

                        @foreach (var cat in ForageCategories.ForageCategory)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>


                @if (!string.IsNullOrWhiteSpace(selectedSpeciesType))
                {
                    <div>
                        <label for="use-category-dropdown">Subcategory</label>
                        <select id="use-category-dropdown" class="form-control" @bind="selectedUseCategory">
                            <option value="">(Any)</option>

                            @foreach (var sub in AvailableSubcategories)
                            {
                                <option value="@sub">@sub</option>
                            }
                        </select>
                    </div>
                }


                <div style="min-width:240px; position:relative;">

                    <label for="user-search">Search by user</label>
                    <InputText id="user-search"
                               @bind-Value="userSearchTerm"
                               placeholder="Username (optional)…"
                               class="form-control"
                               @oninput="UserSearchInputChanged" />

                    @if (filteredUserResults.Any())
                    {
                        <ul id="results-dropdown" class="dropdown-menu show" style="display:block; position:absolute; z-index:5; width:100%;">
                            @foreach (var result in filteredUserResults)
                            {
                                <li class="dropdown-item" @onclick="() => SelectUserSearchResult(result)">@result</li>
                            }
                        </ul>
                    }
                </div>

                <div style="min-width:300px;">
                    <label class="d-block">Date Added</label>

                    <div style="display:flex; flex-direction:column; gap:6px;">
                        <label style="display:flex; gap:8px; align-items:center;">
                            <input type="radio" name="dateMode" checked="@(dateMode == DateMode.Any)"
                                   @onchange="@(() => SetDateMode(DateMode.Any))" />
                            Any
                        </label>

                        <label style="display:flex; gap:8px; align-items:center;">
                            <input type="radio" name="dateMode" checked="@(dateMode == DateMode.Exact)"
                                   @onchange="@(() => SetDateMode(DateMode.Exact))" />
                            Exact Date
                            <InputDate DateTime? class="form-control"
                                       style="max-width:180px;"
                                       @bind-Value="exactDate"
                                       disabled="@(dateMode != DateMode.Exact)" />
                        </label>

                        <label style="display:flex; gap:8px; align-items:center;">
                            <input type="radio" name="dateMode" checked="@(dateMode == DateMode.Range)"
                                   @onchange="@(() => SetDateMode(DateMode.Range))" />
                            Range
                        </label>

                        @if (dateMode == DateMode.Range)
                        {
                            <div style="display:flex; gap:8px; padding-left:26px;">
                                <InputDate DateTime? class="form-control"
                                           style="max-width:160px;"
                                           @bind-Value="rangeStart" />
                                <InputDate DateTime? class="form-control"
                                           style="max-width:160px;"
                                           @bind-Value="rangeEnd" />
                            </div>
                        }

                        <label style="display:flex; gap:8px; align-items:center;">
                            <input type="radio" name="dateMode" checked="@(dateMode == DateMode.Months)"
                                   @onchange="@(() => SetDateMode(DateMode.Months))" />
                            Months
                        </label>

                        @if (dateMode == DateMode.Months)
                        {
                            <div style="padding-left:26px; position:relative; max-width:260px;">
                                <button type="button" class="btn btn-outline-secondary w-100"
                                        @onclick="ToggleMonthsDropdown">
                                    @MonthsButtonText
                                </button>

                                @if (isMonthsDropdownOpen)
                                {
                                    <div class="dropdown-menu show"
                                         style="display:block; max-height:220px; overflow:auto; width:100%; padding:10px;">
                                        <div style="display:flex; gap:8px; margin-bottom:8px;">
                                            <button type="button" class="btn btn-sm btn-light" @onclick="SelectAllMonths">All</button>
                                            <button type="button" class="btn btn-sm btn-light" @onclick="SelectNoMonths">None</button>
                                            <button type="button" class="btn btn-sm btn-light ms-auto" @onclick="ToggleMonthsDropdown">✕</button>
                                        </div>

                                        @foreach (var m in monthOptions)
                                        {
                                            <label style="display:flex; gap:8px; align-items:center; margin:4px 0;">
                                                <InputCheckbox @bind-Value="m.Selected" />
                                                @m.Name
                                            </label>
                                        }

                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>


            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<MapSearchCriteria> OnSearch { get; set; }

    private DateMode dateMode = DateMode.Any;

    private DateTime? exactDate = null;
    private DateTime? rangeStart = null;
    private DateTime? rangeEnd = null;

    private bool isMonthsDropdownOpen = false;

    private sealed class MonthOption
    {
        public int Month { get; set; }          // 1..12
        public string Name { get; set; } = "";
        public bool Selected { get; set; }
    }

    private List<MonthOption> monthOptions = new();

    private enum ScopeSelection
    {
        AllUsers,
        UserOnly,
        FriendUsers
    }

    private enum DateMode
    {
        Any,
        Exact,
        Range,
        Months
    }

    protected override void OnInitialized()
    {
        monthOptions = new List<MonthOption>
        {
            new() { Month = 1,  Name = "January" },
            new() { Month = 2,  Name = "February" },
            new() { Month = 3,  Name = "March" },
            new() { Month = 4,  Name = "April" },
            new() { Month = 5,  Name = "May" },
            new() { Month = 6,  Name = "June" },
            new() { Month = 7,  Name = "July" },
            new() { Month = 8,  Name = "August" },
            new() { Month = 9,  Name = "September" },
            new() { Month = 10, Name = "October" },
            new() { Month = 11, Name = "November" },
            new() { Month = 12, Name = "December" },
        };
    }

    private void ToggleFilters()
    {
        areFiltersVisible = !areFiltersVisible;
    }

    private int ActiveFilterCount
    {
        get
        {
            int count = 0;

            // Scope: count only if NOT default (AllUsers)
            if (scope != ScopeSelection.AllUsers) count++;

            // Category/subcategory
            if (!string.IsNullOrWhiteSpace(selectedSpeciesType)) count++;
            if (!string.IsNullOrWhiteSpace(selectedUseCategory)) count++;

            // User search
            if (!string.IsNullOrWhiteSpace(userSearchTerm)) count++;

            // Location
            if (selectedLocation != null) count++;

            // Date filter: count if anything beyond "Any"
            if (dateMode != DateMode.Any)
            {
                // if they picked a mode but didn’t fill anything out, you can choose to count or not.
                // This version counts it as active when mode != Any.
                count++;
            }

            return count;
        }
    }


    private void SetDateMode(DateMode mode)
    {
        dateMode = mode;

        if (mode != DateMode.Exact) exactDate = null;
        if (mode != DateMode.Range) { rangeStart = null; rangeEnd = null; }

        if (mode != DateMode.Months)
        {
            foreach (var m in monthOptions) m.Selected = false;
            isMonthsDropdownOpen = false;
        }
    }


    private void ToggleMonthsDropdown()
    {
        isMonthsDropdownOpen = !isMonthsDropdownOpen;
    }

    private void SelectAllMonths()
    {
        foreach (var m in monthOptions) m.Selected = true;
    }


    private void SelectNoMonths()
    {
        foreach (var m in monthOptions) m.Selected = false;
    }


    private string MonthsButtonText
    {
        get
        {
            var picked = monthOptions.Where(m => m.Selected).Select(m => m.Name).ToList();

            if (picked.Count == 0) return "Select months…";
            if (picked.Count == 12) return "All months";
            if (picked.Count <= 2) return string.Join(", ", picked);

            return $"{picked.Count} months selected";
        }
    }


    private List<int> GetSelectedMonths()
    {
        return monthOptions.Where(m => m.Selected).Select(m => m.Month).ToList();
    }


    private ScopeSelection scope = ScopeSelection.AllUsers;

    // UI state
    private bool areFiltersVisible = false;
    private string keywordSearchTerm = string.Empty;
    private string selectedSpeciesType = string.Empty;
    private string selectedUseCategory = string.Empty;
    private string userSearchTerm = string.Empty;
    private List<string> filteredUserResults = new();

    private bool isAllFinds => scope == ScopeSelection.AllUsers;
    private bool isMyFinds => scope == ScopeSelection.UserOnly;
    private bool isFriendsFinds => scope == ScopeSelection.FriendUsers;

    private string locationTerm = "";
    private List<ForagerSite.DataContainer.GeoPolyRecord> locationSuggestions = new();
    private ForagerSite.DataContainer.GeoPolyRecord? selectedLocation = null;

    private async Task LocationInputChanged(ChangeEventArgs e)
    {
        locationTerm = e.Value?.ToString() ?? "";
        selectedLocation = null;

        // tiny debounce to stop spam while typing
        await Task.Delay(150);

        locationSuggestions = geoIndex.Search(locationTerm, limit: 8);
    }

    private void SelectLocation(ForagerSite.DataContainer.GeoPolyRecord s)
    {
        selectedLocation = s;
        locationTerm = s.Display;
        locationSuggestions.Clear();
    }

    private void SetScope(ScopeSelection selected)
    {
        // Mutually exclusive checkboxes: clicking any option selects it,
        // and one option is always selected.
        scope = selected;
        StateHasChanged();
    }

    private async Task UserSearchInputChanged(ChangeEventArgs e)
    {
        userSearchTerm = e.Value?.ToString() ?? string.Empty;

        var term = userSearchTerm.Trim();
        if (term.Length == 0)
        {
            filteredUserResults.Clear();
            return;
        }

        var userNames = await userService.GetAllUserNames();
        filteredUserResults = userNames
            .Where(u => u.StartsWith(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void SelectUserSearchResult(string result)
    {
        userSearchTerm = result;
        filteredUserResults.Clear();
    }

    private async Task SearchClicked()
    {
        var criteria = new MapSearchCriteria
        {
            Scope = scope.ToString(),
            SelectedSpeciesType = selectedSpeciesType,
            SelectedUseCategory = selectedUseCategory,
            UserSearchTerm = userSearchTerm,
            KeywordSearchTerm = keywordSearchTerm,

            LocationKind = selectedLocation?.Kind ?? "",
            LocationId = selectedLocation?.Id ?? "",
            LocationDisplay = selectedLocation?.Display ?? "",

            DateMode = dateMode.ToString(),
            DateExact = exactDate,
            DateFrom = rangeStart,
            DateTo = rangeEnd,
            Months = GetSelectedMonths(),

        };

        await OnSearch.InvokeAsync(criteria);
    }
    private void OnSpeciesTypeChanged()
    {
        // reset subcategory any time category changes (including back to "(Any)")
        selectedUseCategory = string.Empty;
    }

    private IReadOnlyList<string> AvailableSubcategories
    {
        get
        {
            if (string.IsNullOrWhiteSpace(selectedSpeciesType))
                return Array.Empty<string>();

            if (!ForageCategories.Subcategories.TryGetValue(selectedSpeciesType, out var subs))
                return Array.Empty<string>();

            // Prevent the “ghost blank option” by ensuring the selected value is valid
            if (!string.IsNullOrWhiteSpace(selectedUseCategory) && !subs.Contains(selectedUseCategory))
                selectedUseCategory = string.Empty;

            return subs;
        }
    }

    public class MapSearchCriteria
    {
        public string Scope { get; set; } = ScopeSelection.AllUsers.ToString();
        public string SelectedSpeciesType { get; set; } = string.Empty;
        public string SelectedUseCategory { get; set; } = string.Empty;
        public string UserSearchTerm { get; set; } = string.Empty;
        public string KeywordSearchTerm { get; set; } = string.Empty;

        public string LocationKind { get; set; } = "";
        public string LocationId { get; set; } = "";
        public string LocationDisplay { get; set; } = "";

        public string DateMode { get; set; } = "Any";          // Any, Exact, Range, Months
        public DateTime? DateExact { get; set; } = null;       // Exact
        public DateTime? DateFrom { get; set; } = null;        // Range
        public DateTime? DateTo { get; set; } = null;          // Range
        public List<int> Months { get; set; } = new();         // Months mode (1..12)




    }
}
