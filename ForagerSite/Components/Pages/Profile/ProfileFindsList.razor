@using ForagerSite.Components.Find
@using ForagerSite.Features.Finds
@using ForagerSite.Services.Interfaces
@using ForagerSite.DataContainer
@using ForagerSite.Utilities
@inject IUserSessionService session
@inject IJSRuntime JSRuntime
@inject FindQueries findQueries
@inject FindCommands findCommands
@inject NavigationManager navigationManager

<div id="finds-Container">
    <h3>Finds (@ViewModels.Count)</h3>
    <div id="finds-grid" style="flex: 1; overflow-y: auto; border: 1px solid #ccc; background-color: #f9f9f9;">
        @if (IsLoading && !HasLoaded)
        {
            <div class="loading-indicator"><p>Loading...</p></div>
        }
        else if (ViewModels.Count > 0)
        {
            <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                    @foreach (var summary in ViewModels)
                    {
                        var isExpanded = expandedFindId == summary.FindId;
                        <tr id="@GetFindRowId(summary.FindId)"
                            style="cursor: pointer;"
                            @onclick="() => ToggleRowExpansion(summary)"
                            class="@(isExpanded ? "expanded" : string.Empty)">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(summary.PreviewImageUrl))
                                {
                                    <img src="@summary.PreviewImageUrl" alt="@summary.Name"
                                         style="width:100px; height:100px; border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    <span>No image available</span>
                                }
                            </td>
                            <td style="padding: 10px; border-bottom: 1px solid #ddd;">@summary.Name</td>
                            <td style="padding: 10px; border-bottom: 1px solid #ddd;">@summary.SpeciesType</td>
                        </tr>
                        @if (isExpanded)
                        {
                            <tr>
                                <td colspan="4" style="padding: 10px; border-bottom: 1px solid #ddd;">
                                    @if (selectedFind is null)
                                    {
                                        <p>Loading find details...</p>
                                    }
                                    else if (showEditForm && currentEditModel is not null)
                                    {
                                        <FindEditForm @key="currentEditModel.FindId"
                                                      Model="currentEditModel"
                                                      OnClose="CloseEditForm"
                                                      OnUpdated="CloseEditForm"
                                                      OnFindUpdated="HandleFindUpdated" />
                                    }
                                    else
                                    {
                                        <div style="padding-left: 20px;">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => GetDirections(selectedFind.findLocation.latitude, selectedFind.findLocation.longitude)">
                                                📍 Get Directions
                                            </button>
                                            @if (selectedFind.findImages?.Count > 0)
                                            {
                                                <FindImageGallery Images="@selectedFind.findImages" />
                                            }
                                            else
                                            {
                                                <p>No image available</p>
                                            }
                                            <p><strong>Discovered:</strong> @selectedFind.findDate.ToString("MMMM dd, yyyy")</p>
                                            @if (!string.IsNullOrWhiteSpace(selectedFind.speciesName))
                                            {
                                                <p><strong>Species Name:</strong> @selectedFind.speciesName</p>
                                            }
                                            <p><strong>Category:</strong> @selectedFind.speciesType</p>
                                            <p><strong>SubCategory:</strong> @selectedFind.useCategory</p>
                                            @if (!string.IsNullOrWhiteSpace(selectedFind.features))
                                            {
                                                <p><strong>Distinguishing Features:</strong> @selectedFind.features</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedFind.lookAlikes))
                                            {
                                                <p><strong>Dangerous Lookalikes:</strong> @selectedFind.lookAlikes</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(selectedFind.description))
                                            {
                                                <p><strong>Notes:</strong> @selectedFind.description</p>
                                            }
                                            @if (summary.OwnerId == session.SessionUser.UserId)
                                            {
                                                <p><strong>Who can see this?</strong> @selectedFind.accessibility</p>
                                            }
                                            <p><a href="#" @onclick="() => ViewOnMap(summary.OwnerId, summary.FindId)" @onclick:preventDefault="true">View on map</a></p>
                                            <Vote find="selectedFind"
                                                  comment="@null"
                                                  findOrCommentId="selectedFind.findId"
                                                  voteType="find"
                                                  OnChanged="RefreshFindDetailAsync" />
                                            @if (selectedFind.findUserId == session.SessionUser.UserId)
                                            {
                                                <div style="display: flex; gap: 10px;">
                                                    <button class="btn btn-secondary" @onclick="() => OpenEdit(selectedFind)">Edit</button>
                                                    <button class="btn btn-danger" @onclick="() => HandleFindDeleted(selectedFind.findId)">Delete</button>
                                                </div>
                                            }
                                            <CommentThread @key="selectedFind.findId"
                                                           Find="selectedFind"
                                                           CurrentUserId="session.SessionUser.UserId"
                                                           UserNames="userNames"
                                                           OnChanged="RefreshFindDetailAsync" />
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else if (HasLoaded)
        {
            <div class="no-data-indicator"><p>No data available.</p></div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ProfileFindSummary> ViewModels { get; set; } = Array.Empty<ProfileFindSummary>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasLoaded { get; set; }
    [Parameter] public EventCallback OnFindsChanged { get; set; }

    private Guid? expandedFindId;
    private FindEditForm.FindEditTemp? currentEditModel;
    private FindDC? selectedFind;
    private Dictionary<Guid, string> userNames = new();
    private bool showEditForm;

    protected override async Task OnParametersSetAsync()
    {
        if (expandedFindId.HasValue && !ViewModels.Any(find => find.FindId == expandedFindId.Value))
        {
            expandedFindId = null;
            selectedFind = null;
            showEditForm = false;
            currentEditModel = null;
        }
        if (expandedFindId.HasValue && selectedFind is null)
            await LoadFindDetailAsync(expandedFindId.Value);
    }

    private async Task ToggleRowExpansion(ProfileFindSummary summary)
    {
        if (expandedFindId == summary.FindId)
        {
            expandedFindId = null;
            selectedFind = null;
            showEditForm = false;
            currentEditModel = null;
            return;
        }

        expandedFindId = summary.FindId;
        selectedFind = null;
        showEditForm = false;
        currentEditModel = null;
        await LoadFindDetailAsync(summary.FindId);
    }

    private async Task LoadFindDetailAsync(Guid findId)
    {
        var detail = await findQueries.GetFindDetailByIdAsync(findId);
        if (expandedFindId != findId)
            return;

        selectedFind = detail?.finds.FirstOrDefault(find => find.findId == findId);
        userNames = selectedFind is null
            ? new Dictionary<Guid, string>()
            : await findQueries.GetUserNamesAsync(selectedFind.findsCommentXrefs.Select(xref => xref.comxUserId));
    }

    private async Task RefreshFindDetailAsync(Guid findId)
    {
        if (expandedFindId != findId)
            return;
        await LoadFindDetailAsync(findId);
        await InvokeAsync(StateHasChanged);
    }

    private void OpenEdit(FindDC find)
    {
        currentEditModel = new FindEditForm.FindEditTemp
        {
            FindId = find.findId,
            FindName = find.findName,
            SpeciesName = find.speciesName,
            SpeciesType = find.speciesType,
            UseCategory = find.useCategory,
            Features = find.features,
            LookAlikes = find.lookAlikes,
            HarvestMethod = find.harvestMethod,
            TastesLike = find.tastesLike,
            Description = find.description,
            ExistingImageUrls = find.findImages.Select(image => image.imageData).ToList(),
            AccessLevel = find.accessibility
        };
        showEditForm = true;
    }

    private Task CloseEditForm()
    {
        showEditForm = false;
        currentEditModel = null;
        return Task.CompletedTask;
    }

    private async Task HandleFindUpdated(FindEditForm.FindEditTemp temp)
    {
        if (selectedFind?.findLocation is null)
            return;

        await findCommands.UpdateAsync(new UpdateFindRequest(
            temp.FindId,
            temp.FindName,
            temp.SpeciesName ?? string.Empty,
            temp.SpeciesType,
            temp.UseCategory,
            temp.Features ?? string.Empty,
            temp.LookAlikes ?? string.Empty,
            temp.HarvestMethod ?? string.Empty,
            temp.TastesLike ?? string.Empty,
            temp.Description ?? string.Empty,
            selectedFind.findLocation.latitude,
            selectedFind.findLocation.longitude,
            temp.ImageFilesToAdd,
            temp.DeletedImageUrls,
            temp.AccessLevel));

        await OnFindsChanged.InvokeAsync();
        await RefreshFindDetailAsync(temp.FindId);
        await CloseEditForm();
    }

    private async Task HandleFindDeleted(Guid findId)
    {
        await findCommands.DeleteAsync(findId);
        expandedFindId = null;
        selectedFind = null;
        await OnFindsChanged.InvokeAsync();
    }

    private string GetFindRowId(Guid findId) => $"find-row-{findId}";

    private void ViewOnMap(Guid userId, Guid findId) =>
        navigationManager.NavigateTo($"/map?focusFindId={findId}&focusUserId={userId}");

    private Task GetDirections(double latitude, double longitude) =>
        DirectionsHelper.OpenAsync(JSRuntime, latitude, longitude);
}
