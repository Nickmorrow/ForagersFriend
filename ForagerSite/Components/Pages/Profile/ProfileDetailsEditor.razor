@namespace ForagerSite.Components.Profile
@using ForagerSite.DataContainer;
@using ForagerSite.Services
@using ForagerSite.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms

@inject IUserService userService

<EditForm Model="UserVm" OnValidSubmit="SaveChanges">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label for="name">Name:</label>
        <InputText id="name" @bind-Value="UserVm.UsrName" />
    </div>

    <div>
        <label for="bio">Bio:</label>
        <InputTextArea id="bio" @bind-Value="UserVm.UsrBio" />
        <ValidationMessage For="@(() => UserVm.UsrBio)" />
        @if (UserVm.UsrBio?.Length > 250)
        {
            <p style="color: red;">Bio cannot exceed 250 characters.</p>
        }
    </div>

    <div>
        <label for="country">Country:</label>
        <InputText id="country" @bind-Value="UserVm.UsrCountry" />
    </div>

    <div>
        <label for="state">State/Province:</label>
        <InputText id="state" @bind-Value="UserVm.UsrStateorProvince" />
    </div>

    <div>
        <label for="zipcode">Zip Code:</label>
        <InputNumber id="zipcode" @bind-Value="UserVm.UsrZipCode" />
        @if (!IsValidZipCode(UserVm.UsrZipCode))
        {
            <p style="color: red;">Please enter a valid zip code.</p>
        }
    </div>

    <div>
        <button type="submit">Save</button>
        <button type="button" @onclick="CancelEdit">Cancel</button>
    </div>
</EditForm>

@code {
    [Parameter] public UserProfileDto UserVm { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private UserProfileDto originalUser = new();

    protected override void OnInitialized()
    {
        // Snapshot original values so Cancel can roll back
        originalUser = new UserProfileDto
        {
            UsrId = UserVm.UsrId,
            Username = UserVm.Username,
            UsrName = UserVm.UsrName,
            UsrBio = UserVm.UsrBio,
            UsrCountry = UserVm.UsrCountry,
            UsrStateorProvince = UserVm.UsrStateorProvince,
            UsrZipCode = UserVm.UsrZipCode
        };
    }

    private bool IsValidZipCode(int? zipCode)
    {
        if (zipCode == null) return false;
        return zipCode >= 10000 && zipCode <= 99999;
    }

    private async Task SaveChanges()
    {
        await userService.UpdateUser(UserVm);

        if (OnSaved.HasDelegate)
        {
            await OnSaved.InvokeAsync();
        }
    }

    private async Task CancelEdit()
    {
        // Restore from snapshot
        UserVm.UsrName = originalUser.UsrName;
        UserVm.UsrBio = originalUser.UsrBio;
        UserVm.UsrCountry = originalUser.UsrCountry;
        UserVm.UsrStateorProvince = originalUser.UsrStateorProvince;
        UserVm.UsrZipCode = originalUser.UsrZipCode;

        if (OnCancelled.HasDelegate)
        {
            await OnCancelled.InvokeAsync();
        }
    }
}
