@page "/Inbox"
@page "/Inbox/{threadId:guid}"
@rendermode InteractiveServer

@using ForagerSite.DataContainer
@using ForagerSite.Services.Interfaces
@inject IUserSessionService session
@inject IInboxService inboxService
@inject NavigationManager nav

@if (!loaded)
{
    <p>Loading...</p>
}
else if (!session.IsAuthenticated || session.SessionUser is null)
{
    <p>Please log in.</p>
}
else
{
    <div style="display:flex; gap:16px; align-items:flex-start;">

        <InboxSidebar Folder="folder"
                      OnFolderChanged="ChangeFolder"
                      OnCompose="OpenCompose" />

        <div style="flex:1;">
            <InboxSearchBar Search="search" OnSearchChanged="OnSearchChanged" />

            @if (threadId is null)
            {
                <ThreadList Threads="threads"
                            OnOpenThread="OpenThread"
                            OnMarkRead="MarkRead"
                            OnArchive="Archive"
                            OnTrash="Trash" />
            }
            else
            {
                <ThreadView Thread="thread"
                            OnBack="BackToList" />
            }
        </div>
    </div>
    <ComposeMessageModal IsOpen="showCompose"
                         CurrentUserId="session.SessionUser!.UserId"
                         OnCancel="CloseCompose"
                         OnSent="OnComposeSent" />

}

@code {
    [Parameter] public Guid? threadId { get; set; }

    private bool showCompose;
    private bool loaded;
    private MailboxFolder folder = MailboxFolder.Inbox;
    private string search = "";
    private List<ThreadListItemDc> threads = new();
    private ThreadDc? thread;

    protected override async Task OnInitializedAsync()
    {
        await session.Load();
        loaded = true;
        await LoadList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!loaded) return;
        if (!session.IsAuthenticated || session.SessionUser is null) return;

        if (threadId is not null)
        {
            thread = await inboxService.GetThread(session.SessionUser.UserId, threadId.Value);
            await inboxService.MarkRead(session.SessionUser.UserId, threadId.Value);
        }
        else
        {
            thread = null;
            await LoadList();
        }
    }

    private async Task LoadList()
    {
        if (!session.IsAuthenticated || session.SessionUser is null) return;
        threads = await inboxService.GetThreads(session.SessionUser.UserId, folder, search, take: 50);
        StateHasChanged();
    }

    private async Task ChangeFolder(MailboxFolder f)
    {
        folder = f;
        threadId = null;
        thread = null;
        nav.NavigateTo("/Inbox");
        await LoadList();
    }

    private async Task OnSearchChanged(string term)
    {
        search = term;
        threadId = null;
        thread = null;
        nav.NavigateTo("/Inbox");
        await LoadList();
    }

    private void OpenThread(Guid id) => nav.NavigateTo($"/Inbox/{id}");
    private void BackToList() => nav.NavigateTo("/Inbox");

    private async Task MarkRead(Guid id) { await inboxService.MarkRead(session.SessionUser!.UserId, id); await LoadList(); }
    private async Task Archive(Guid id) { await inboxService.ArchiveThread(session.SessionUser!.UserId, id); await LoadList(); }
    private async Task Trash(Guid id) { await inboxService.TrashThread(session.SessionUser!.UserId, id); await LoadList(); }

    private void OpenCompose() => showCompose = true;
    private void CloseCompose() => showCompose = false;

    private void OnComposeSent(Guid newThreadId)
    {
        showCompose = false;
        nav.NavigateTo($"/Inbox/{newThreadId}");
    }


}
