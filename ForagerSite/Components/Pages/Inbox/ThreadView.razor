@using ForagerSite.DataContainer
@using ForagerSite.Services.Interfaces
@inject IUserSessionService session
@inject IInboxService inboxService

@if (Thread is null)
{
    <p>Loading thread...</p>
}
else
{
    <button class="btn btn-sm btn-link" @onclick="OnBack">← Back</button>
    <h5>Conversation with @Thread.OtherUserName</h5>

    <div class="border rounded p-2 mb-2" style="background:#fff;">
        @foreach (var m in Thread.Messages)
        {
            <div class="mb-2">
                <div style="font-size:.85em; opacity:.8;">
                    <strong>@m.SenderName</strong> • @m.SentUtc.ToLocalTime().ToString("g")
                </div>
                <div>@m.Body</div>
            </div>
            <hr />
        }
    </div>

    <div class="border-top pt-2 mt-3">
        <textarea class="form-control mb-2"
                  rows="4"
                  placeholder="Reply..."
                  @bind="replyBody"></textarea>

        <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-secondary btn-sm" @onclick="ClearReply">Cancel</button>

            <button class="btn btn-primary btn-sm"
                    disabled="@string.IsNullOrWhiteSpace(replyBody)"
                    @onclick="SendReply">
                Send
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public ThreadDc? Thread { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private string replyBody = "";

    private void ClearReply() => replyBody = "";

    private async Task SendReply()
    {
        if (Thread is null || session.SessionUser is null) return;

        await inboxService.SendMessage(
            senderId: session.SessionUser.UserId,
            recipientId: Thread.OtherUserId,
            subject: Thread.Messages.LastOrDefault()?.Subject ?? "(no subject)",
            body: replyBody,
            threadId: Thread.ThreadId
        );

        replyBody = "";

        // simplest refresh: re-load the thread
        Thread = await inboxService.GetThread(session.SessionUser.UserId, Thread.ThreadId);
        await inboxService.MarkRead(session.SessionUser.UserId, Thread.ThreadId);
    }
}
