@using ForagerSite.CommonRules.ForagerSite.CommonRules
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using ForagerSite.Services
@using ForagerSite.Services.Interfaces
@using ForagerSite.Utilities
@using ForagerSite.Components.Utility
@using ForagerSite.CommonRules
@inject IUserSessionService session
@inject IConfiguration config
@inject IWebHostEnvironment env
@inject IJSRuntime JS


<div>
<EditForm Model="findModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label for="findName">Name:</label>
        <InputText id="findName" @bind-Value="findModel.FindName" />
    </div>

    <div>
        <label for="speciesName">Species:</label>
        <InputText id="speciesName" @bind-Value="findModel.SpeciesName" />
    </div>
    <div>
        <InputSelect id="speciesType"
                     @bind-Value="findModel.SpeciesType"
                     @bind-Value:after="OnSpeciesTypeChanged">
            <option value="">Select Type</option>

            @foreach (var category in ForageCategories.ForageCategory)
            {
                <option value="@category">@category</option>
            }
        </InputSelect>
    </div>

    @if (!string.IsNullOrWhiteSpace(findModel.SpeciesType))
    {
        <div>

                    @if (!string.IsNullOrWhiteSpace(findModel.SpeciesType))
                    {
                        <div style="margin-top:10px;">
                            <label>Subcategories:</label>

                            <!-- Available list -->
                            <div style="border:1px solid #ccc; border-radius:6px; padding:8px; max-width:420px;">
                                @if (AvailableSubcategoriesExcludingSelected.Count == 0)
                                {
                                    <small class="text-muted">No more subcategories to add.</small>
                                }
                                else
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                        @foreach (var sub in AvailableSubcategoriesExcludingSelected)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => AddSubcategory(sub)">
                                                + @sub
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Selected list -->
                            <div style="margin-top:10px;">
                                <label class="d-block">Selected:</label>

                                @if (selectedSubcategories.Count == 0)
                                {
                                    <small class="text-muted">None selected yet.</small>
                                }
                                else
                                {
                                    <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                        @foreach (var sub in selectedSubcategories)
                                        {
                                            <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 8px; border:1px solid #aaa; border-radius:999px;">
                                                @sub
                                                <button type="button"
                                                        class="btn btn-sm btn-link"
                                                        style="padding:0; text-decoration:none;"
                                                        @onclick="() => RemoveSubcategory(sub)">
                                                    ✕
                                                </button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Optional: show stored string -->
                            @if (!string.IsNullOrWhiteSpace(findModel.UseCategory))
                            {
                                <div style="margin-top:6px;">
                                    <small class="text-muted">Stored: @findModel.UseCategory</small>
                                </div>
                            }
                        </div>
                    }



            @if (!string.IsNullOrWhiteSpace(findModel.UseCategory))
            {
                <small>Selected: @findModel.UseCategory</small>
            }
        </div>
    }

    <div>
        <label for="features">Distinguishing Features:</label>
        <InputText id="features" @bind-Value="findModel.Features" />
    </div>

    <div>
        <label for="lookAlikes">Dangerous Lookalikes:</label>
        <InputText id="lookAlikes" @bind-Value="findModel.LookAlikes" />
    </div>

    @* <div>
        <label for="harvestMethod">Harvest Method:</label>
        <InputText id="harvestMethod" @bind-Value="findModel.HarvestMethod" />
    </div>

    <div>
        <label for="tastesLike">Tastes Like:</label>
        <InputText id="tastesLike" @bind-Value="findModel.TastesLike" />
    </div> *@

    <div>
        <label for="description">Notes:</label>
        <InputTextArea id="description" @bind-Value="findModel.Description" />
    </div>

    <div>
        <label>Images:</label>
        <ImageUploader @ref="imageUploader" OnImagesUploaded="OnImagesUploaded" Errors="uploadErrors" />
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
            @for (int i = 0; i < imagePreviews.Count; i++)
            {
                var currentIndex = i;
                <div @key="imagePreviews[i]" style="position: relative; display: inline-block;">
                    <img src="@imagePreviews[i]" style="max-width: 100px; max-height: 100px;" />
                    <button type="button"
                            @onclick="() => RemoveImage(currentIndex)"
                            style="position: absolute; top: -5px; right: -5px;">
                        ✕
                    </button>
                </div>
            }
        </div>

        @if (uploadErrors.Any())
        {
            <ul style="color: red;">
                @foreach (var err in uploadErrors)
                {
                    <li>@err</li>
                }
            </ul>
        }

    </div>
    <div>
        <label>Who can see this?</label>
            <InputSelect @bind-Value="findModel.AccessLevel">
            <option value="Public">Public</option>
            <option value="Private">Private</option>
            <option value="Friends Only">Friends Only</option>
        </InputSelect>
    </div>
    <button type="submit">Save</button>
    <button @onclick="OnClose">Cancel</button> 
    </EditForm>
</div>
@code {
    private FindTemp findModel = new();
    private List<string> uploadErrors = new();
    private List<string> imagePreviews = new();
    private List<IBrowserFile> selectedFiles = new();
    private ImageUploader imageUploader;

    [Parameter]
    public EventCallback<FindTemp> OnFindCreated { get; set; }

    [Parameter]
    public EventCallback OnCreated { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference useCategorySelect;

    private List<string> selectedSubcategories = new();

    private IReadOnlyList<string> AvailableSubcategories =>
        string.IsNullOrWhiteSpace(findModel.SpeciesType)
            ? Array.Empty<string>()
            : ForageCategories.Subcategories.TryGetValue(findModel.SpeciesType, out var subs)
                ? subs
                : Array.Empty<string>();

    private List<string> AvailableSubcategoriesExcludingSelected =>
        AvailableSubcategories
            .Where(s => !selectedSubcategories.Contains(s))
            .ToList();

    private void AddSubcategory(string sub)
    {
        if (!selectedSubcategories.Contains(sub))
            selectedSubcategories.Add(sub);

        SyncUseCategoryString();
    }

    private void RemoveSubcategory(string sub)
    {
        selectedSubcategories.Remove(sub);
        SyncUseCategoryString();
    }

    private void SyncUseCategoryString()
    {
        // store as comma-separated string in your model
        findModel.UseCategory = string.Join(", ", selectedSubcategories);
    }

    private void OnSpeciesTypeChanged()
    {
        selectedSubcategories.Clear();
        findModel.UseCategory = "";
    }
    private void HydrateSelectedFromModel()
    {
        selectedSubcategories = (findModel.UseCategory ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct()
            .ToList();
    }

    private Task OnImagesUploaded(ImageUploadResult result)
    {
        uploadErrors.Clear();

        imagePreviews = result.Previews ?? new List<string>();
        selectedFiles = result.Files ?? new List<IBrowserFile>();

        StateHasChanged();

        return Task.CompletedTask;
    }

    private void ClearUploadedImages()
    {
        imagePreviews.Clear();
        selectedFiles.Clear();
        uploadErrors.Clear();

        imageUploader?.ResetFileInput();
    }

    private void RemoveImage(int index)
    {
        if (index >= 0 && index < imagePreviews.Count)
        {
            imagePreviews.RemoveAt(index);

            if (index < selectedFiles.Count)
            {
                selectedFiles.RemoveAt(index);
            }

            if (imagePreviews.Count == 0)
            {
                imageUploader?.ResetInput();
            }

            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        uploadErrors.Clear(); 

        var userId = session.SessionUser.UserId;
        var userName = session.SessionUser.Username;
        findModel.UserId = userId;

        var uploadedUrls = await PhotoUploadHelper.UploadFindImages(selectedFiles, userName, config, env, uploadErrors);

        if (uploadErrors.Any())
        {
            return;
        }

        findModel.ImageUrls = uploadedUrls;

        findModel.AccessLevel = string.IsNullOrEmpty(findModel.AccessLevel) ? "Public" : findModel.AccessLevel;

        await OnFindCreated.InvokeAsync(findModel);

        findModel = new();
        imagePreviews.Clear();
    }



    public class FindTemp
    {
        [Required] public string FindName { get; set; }
        public string SpeciesName { get; set; } = "";
        [Required] public string SpeciesType { get; set; } 
        [Required] public string UseCategory { get; set; }
        public string Features { get; set; } = "";
        public string LookAlikes { get; set; } = "";
        public string HarvestMethod { get; set; } = "";
        public string TastesLike { get; set; } = "";
        public string Description { get; set; } = "";
        public string AccessLevel { get; set; }
        public Guid UserId { get; set; }
        public List<string> ImageUrls { get; set; } = new();
    }
}
