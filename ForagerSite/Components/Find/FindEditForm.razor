@using ForagerSite.CommonRules.ForagerSite.CommonRules
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using ForagerSite.Services
@using ForagerSite.Services.Interfaces
@using ForagerSite.Utilities
@using ForagerSite.Components.Utility
@using DataAccess.Models
@inject IUserSessionService session
@inject IConfiguration config
@inject IWebHostEnvironment env

<EditForm Model="editModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label for="findName">Name:</label>
        <p></p>
        <InputText id="findName" @bind-Value="editModel.FindName" />
    </div>

    <div>
        <label for="speciesName">Species:</label>
        <InputText id="speciesName" @bind-Value="editModel.SpeciesName" />
    </div>

    <div>
        <InputSelect id="speciesType"
                     @bind-Value="editModel.SpeciesType"
                     @bind-Value:after="OnSpeciesTypeChanged">
            <option value="">Select Type</option>

            @foreach (var category in ForageCategories.ForageCategory)
            {
                <option value="@category">@category</option>
            }
        </InputSelect>
    </div>
    @if (!string.IsNullOrWhiteSpace(editModel.SpeciesType))
    {
        <div>
            <label for="useCategory">Subcategories:</label>

            @if (!string.IsNullOrWhiteSpace(editModel.SpeciesType))
            {
                <div style="margin-top:10px;">
                    <label>Subcategories:</label>

                    <!-- Available list -->
                    <div style="border:1px solid #ccc; border-radius:6px; padding:8px; max-width:420px;">
                        @if (AvailableSubcategoriesExcludingSelected.Count == 0)
                        {
                            <small class="text-muted">No more subcategories to add.</small>
                        }
                        else
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                @foreach (var sub in AvailableSubcategoriesExcludingSelected)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => AddSubcategory(sub)">
                                        + @sub
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Selected list -->
                    <div style="margin-top:10px;">
                        <label class="d-block">Selected:</label>

                        @if (selectedSubcategories.Count == 0)
                        {
                            <small class="text-muted">None selected yet.</small>
                        }
                        else
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                @foreach (var sub in selectedSubcategories)
                                {
                                    <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 8px; border:1px solid #aaa; border-radius:999px;">
                                        @sub
                                        <button type="button"
                                                class="btn btn-sm btn-link"
                                                style="padding:0; text-decoration:none;"
                                                @onclick="() => RemoveSubcategory(sub)">
                                            ✕
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Optional: show stored string -->
                    @if (!string.IsNullOrWhiteSpace(editModel.UseCategory))
                    {
                        <div style="margin-top:6px;">
                            <small class="text-muted">Stored: @editModel.UseCategory</small>
                        </div>
                    }
                </div>
            }



            @if (!string.IsNullOrWhiteSpace(editModel.UseCategory))
            {
                <small>Selected: @editModel.UseCategory</small>
            }
        </div>
    }

    <div>
        <label for="features">Distinguishing Features:</label>
        <InputText id="features" @bind-Value="editModel.Features" />
    </div>

    <div>
        <label for="lookAlikes">Dangerous Lookalikes:</label>
        <InputText id="lookAlikes" @bind-Value="editModel.LookAlikes" />
    </div>

    @* <div>
        <label for="harvestMethod">Harvest Method:</label>
        <InputText id="harvestMethod" @bind-Value="editModel.HarvestMethod" />
    </div>

    <div>
        <label for="tastesLike">Tastes Like:</label>
        <InputText id="tastesLike" @bind-Value="editModel.TastesLike" />
    </div> *@

    <div>
        <label for="description">Notes:</label>
        <InputTextArea id="description" @bind-Value="editModel.Description" />
    </div>

    <div>
        <label>Existing Images:</label>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
            @for (int i = 0; i < existingImagePreviews.Count; i++)
            {
                var idx = i;
                <div style="position:relative;display:inline-block;">
                    <img src="@existingImagePreviews[i]" style="max-width:100px;max-height:100px;" />
                    <button type="button"
                            @onclick="() => RemoveExistingImage(idx)"
                            style="position:absolute;top:-5px;right:-5px;">
                        ✕
                    </button>
                </div>
            }
        </div>
    </div>

    <div>
        <label>New Images:</label>
        <ImageUploader @ref="imageUploader"
                       OnImagesUploaded="OnImagesUploaded"
                       Errors="uploadErrors" />

        <div style="display:flex;flex-wrap:wrap;gap:10px;">
            @for (int i = 0; i < newImagePreviews.Count; i++)
            {
                var idx = i;
                <div style="position:relative;display:inline-block;">
                    <img src="@newImagePreviews[i]" style="max-width:100px;max-height:100px;" />
                    <button type="button"
                            @onclick="() => RemoveNewImage(idx)"
                            style="position:absolute;top:-5px;right:-5px;">
                        ✕
                    </button>
                </div>
            }
        </div>

        @if (uploadErrors.Any())
        {
            <ul style="color:red;">
                @foreach (var err in uploadErrors)
                {
                    <li>@err</li>
                }
            </ul>
        }
    </div>
    <div>
        <label>Who can see this?</label>
        <InputSelect @bind-Value="editModel.AccessLevel">
            <option value="Public">Public</option>
            <option value="Private">Private</option>
            <option value="Friends Only">Friends Only</option>
        </InputSelect>       
    </div>

    <button type="submit">Save Changes</button>
    <button type="button" @onclick="OnClose">Cancel</button>
</EditForm>

@code {
    [Parameter]
    public FindEditTemp Model { get; set; } = default!;

    [Parameter]
    public EventCallback<FindEditTemp> OnFindUpdated { get; set; }

    [Parameter]
    public EventCallback OnUpdated { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private FindEditTemp editModel = new();

    private List<string> uploadErrors = new();
    private List<string> existingImagePreviews = new();
    private List<string> newImagePreviews = new();
    private List<IBrowserFile> newFiles = new();

    private ImageUploader? imageUploader;

    protected override void OnParametersSet()
    {
        if (Model is null)
            return;

        if (editModel.FindId != Model.FindId)
        {
            editModel = new FindEditTemp
            {
                FindId = Model.FindId,
                FindName = Model.FindName,
                SpeciesName = Model.SpeciesName,
                SpeciesType = Model.SpeciesType,
                UseCategory = Model.UseCategory,
                Features = Model.Features,
                LookAlikes = Model.LookAlikes,
                HarvestMethod = Model.HarvestMethod,
                TastesLike = Model.TastesLike,
                Description = Model.Description,
                UserId = Model.UserId,

                ExistingImageUrls = new List<string>(Model.ExistingImageUrls ?? new()),
                DeletedImageUrls = new List<string>(),
                UploadedImageUrls = new List<string>()
            };

            HydrateSelectedFromModel(); // ✅ ADD THIS

            existingImagePreviews = new List<string>(editModel.ExistingImageUrls);
            newImagePreviews.Clear();
            newFiles.Clear();
            uploadErrors.Clear();
        }
    }
    private List<string> selectedSubcategories = new();

    private IReadOnlyList<string> AvailableSubcategories =>
        string.IsNullOrWhiteSpace(editModel.SpeciesType)
            ? Array.Empty<string>()
            : ForageCategories.Subcategories.TryGetValue(editModel.SpeciesType, out var subs)
                ? subs
                : Array.Empty<string>();

    private List<string> AvailableSubcategoriesExcludingSelected =>
        AvailableSubcategories
            .Where(s => !selectedSubcategories.Contains(s))
            .ToList();

    private void AddSubcategory(string sub)
    {
        if (!selectedSubcategories.Contains(sub))
            selectedSubcategories.Add(sub);

        SyncUseCategoryString();
    }

    private void RemoveSubcategory(string sub)
    {
        selectedSubcategories.Remove(sub);
        SyncUseCategoryString();
    }

    private void SyncUseCategoryString()
    {
        // store as comma-separated string in your model
        editModel.UseCategory = string.Join(", ", selectedSubcategories);
    }

    private void OnSpeciesTypeChanged()
    {
        selectedSubcategories.Clear();
        editModel.UseCategory = "";
    }
    private void HydrateSelectedFromModel()
    {
        var parsed = (editModel.UseCategory ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Only keep values that exist for the currently selected SpeciesType
        var allowed = new HashSet<string>(AvailableSubcategories, StringComparer.OrdinalIgnoreCase);

        selectedSubcategories = parsed
            .Where(allowed.Contains)
            .ToList();

        // Normalize stored string (nice formatting + removes invalids)
        SyncUseCategoryString();
    }

    private Task OnImagesUploaded(ImageUploadResult result)
    {
        uploadErrors.Clear();
        newImagePreviews = result.Previews ?? new List<string>();
        newFiles = result.Files ?? new List<IBrowserFile>();

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void RemoveExistingImage(int index)
    {
        if (index >= 0 && index < existingImagePreviews.Count)
        {
            var url = existingImagePreviews[index];

            existingImagePreviews.RemoveAt(index);

            if (!editModel.DeletedImageUrls.Contains(url))
            {
                editModel.DeletedImageUrls.Add(url);
            }

            editModel.ExistingImageUrls.Remove(url);

            StateHasChanged();
        }
    }

    private void RemoveNewImage(int index)
    {
        if (index >= 0 && index < newImagePreviews.Count)
        {
            newImagePreviews.RemoveAt(index);

            if (index < newFiles.Count)
                newFiles.RemoveAt(index);

            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        uploadErrors.Clear();

        var userName = session.SessionUser.Username;

        var newUrls = await PhotoUploadHelper.UploadFindImages(
            newFiles, userName, config, env, uploadErrors);

        if (uploadErrors.Any())
            return;

        editModel.AccessLevel = string.IsNullOrEmpty(editModel.AccessLevel) ? "Public" : editModel.AccessLevel;
        editModel.UploadedImageUrls = newUrls;

        await OnFindUpdated.InvokeAsync(editModel);
    }

    public class FindEditTemp
    {
        public Guid FindId { get; set; }

        [Required] public string FindName { get; set; } = "";
        public string? SpeciesName { get; set; }
        [Required] public string SpeciesType { get; set; } = "";
        [Required] public string UseCategory { get; set; } = "";
        public string? Features { get; set; }
        public string? LookAlikes { get; set; }
        public string? HarvestMethod { get; set; }
        public string? TastesLike { get; set; }
        public string? Description { get; set; }
        public string AccessLevel { get; set; } 

        public Guid UserId { get; set; }

        public List<string> ExistingImageUrls { get; set; } = new();
        public List<string> DeletedImageUrls { get; set; } = new();
        public List<string> UploadedImageUrls { get; set; } = new();
    }
}

